DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Used by docker-compose; matches the postgres service there.
DATABASE_URL=postgres://mzansi:mzansi@db:5432/mzansi_lineup

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Production only (config.settings.prod) — your Vercel frontend URL(s),
# scheme included. Leave unset for local dev.
CSRF_TRUSTED_ORIGINS=

# Get a free key at https://developer.ticketmaster.com/ (Discovery API).
TICKETMASTER_API_KEY=

QUICKET_API_KEY=

# Create a free app at https://developer.spotify.com/dashboard for these —
# powers the watchlist search's artist autocomplete (Client Credentials
# flow, no Spotify login). Without them, search just returns no results.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
