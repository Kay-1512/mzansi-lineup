DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Used by docker-compose; matches the postgres service there.
DATABASE_URL=postgres://mzansi:mzansi@db:5432/mzansi_lineup

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Production only (config.settings.prod) — your Vercel frontend URL(s),
# scheme included. Leave unset for local dev.
CSRF_TRUSTED_ORIGINS=

# Get a free key at https://developer.ticketmaster.com/ (Discovery API).
TICKETMASTER_API_KEY=

# Phase 2 — not used yet.
QUICKET_API_KEY=
